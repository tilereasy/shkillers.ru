---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ru-RU", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Блог — shkillers.ru"
  description="Список постов shkillers.ru"
  activePath="blog"
>
  <main>
    <section class="page-section">
      <div class="shell">
        <h1 class="page-title">Блог</h1>
        <p class="page-description">Все опубликованные записи из Markdown-коллекции.</p>
      </div>
    </section>

    <section class="content-section">
      <div class="shell">
        {posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post) => (
              <article class="post-item">
                <div class="post-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span>{post.data.tags[0]}</span>
                </div>
                <div>
                  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">Постов пока нет.</p>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
